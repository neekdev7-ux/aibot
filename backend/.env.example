# NIVA QUANT AI — backend configuration template.
# Copy to .env and adjust. No real secrets belong in this file.
# Paper trading is the default and the only supported mode.

# --- Database / cache -------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://niva:niva_dev_password@db:5432/niva_quant
REDIS_URL=redis://redis:6379/0

# --- Binance public market data (no API key needed) -------------------------
# data-api.binance.vision FIRST: api.binance.com is 451 geo-blocked in some
# clouds. NOTE: vision serves spot /api/v3 only (404s /fapi/v1); the fapi*
# hosts are the USDT-M Futures endpoints. In a geo-restricted network all
# futures hosts may fail (451/redirect) — the scanner reports that honestly.
BINANCE_BASES=https://data-api.binance.vision,https://fapi.binance.com,https://fapi1.binance.com,https://fapi2.binance.com,https://fapi3.binance.com
BINANCE_WS_BASE=wss://fstream.binance.com

# --- Scanner ----------------------------------------------------------------
SCAN_INTERVAL_SECONDS=300
SCAN_TOP_N=60
SCAN_CONCURRENCY=8
SCAN_MIN_QUOTE_VOLUME_24H=10000000
SCAN_MAX_SPREAD_BPS=20
SCAN_MIN_ATR_PCT=0.3
SCAN_MIN_SCORE=65

# --- Timeframes -------------------------------------------------------------
BIAS_TF_1=4h
BIAS_TF_2=1h
SETUP_TF=15m
ENTRY_TF=5m

# --- Risk / trade rules -----------------------------------------------------
PAPER_TRADING=true
MIN_RR=2.0
COOLDOWN_MINUTES=30
MAX_OPEN_TRADES=10

# --- Server -----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
RATE_LIMIT_PER_MINUTE=120
WS_ENABLED=true
